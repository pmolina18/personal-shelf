# Backend — PostgreSQL (Neon.dev in production)
DATABASE_URL=postgresql+asyncpg://user:password@host.neon.tech/dbname?ssl=require

# Backend — CORS origins (comma-separated, omit for permissive dev mode)
ALLOWED_ORIGINS=https://shelfd.net,https://www.shelfd.net

# Backend — JWT secret (generate a strong random value for production)
JWT_SECRET_KEY=change-me-in-production

# Backend — TMDB API key for auto-fetching cover images
TMDB_API_KEY=

# Frontend — absolute URL to the backend API (omit for local dev with Vite proxy)
VITE_API_BASE_URL=https://shelfd-api.onrender.com/api

# Frontend — absolute URL to the backend image endpoint (omit for local dev)
VITE_IMAGES_BASE_URL=https://shelfd-api.onrender.com
