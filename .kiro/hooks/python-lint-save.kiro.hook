{
  "enabled": true,
  "name": "Python Lint on Save",
  "description": "Runs ruff check on Python files when they are saved, catching linting and style issues immediately during backend development.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "**/*.py"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "ruff check --fix ${filePath}"
  }
}