{
  "enabled": false,
  "name": "Validate Schemas on Change",
  "description": "When Pydantic schema files are edited, runs the property tests related to validation (Properties 1, 2, 7, 8, 9) to detect regressions in validation rules. Disabled until backend/tests/ directory exists.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "backend/schemas/*.py"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "python -m pytest backend/tests/ -x --tb=short -q -k \"property_1 or property_2 or property_7 or property_8 or property_9\" 2>&1 | tail -20",
    "timeout": 90
  }
}
