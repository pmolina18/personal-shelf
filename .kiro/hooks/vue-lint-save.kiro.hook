{
  "name": "Vue Lint on Save",
  "description": "Runs ESLint with auto-fix on Vue and JS files when saved. Requires eslint + eslint-plugin-vue installed in frontend/.",
  "version": "1.0.0",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "frontend/**/*.vue",
      "frontend/**/*.js"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "npx eslint --fix ${filePath} --config frontend/eslint.config.js",
    "timeout": 60
  }
}
